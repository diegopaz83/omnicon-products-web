---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Footer from '../../../../components/Footer.astro';
import ProgressList from '../../../../components/ProgressList.astro';
import { getProject, getSite } from '../../../../lib/data';
import { isPublicBuild, url } from '../../../../lib/paths';
import { fill } from '../../../../lib/text';
import type { Project } from '../../../../lib/schema';

// Internal only: no pages at all in public builds (SPEC §5)
export function getStaticPaths() {
  if (isPublicBuild) return [];
  return getSite().products.flatMap((card) => {
    if (card.status !== 'available') return [];
    const project = getProject(card.slug);
    return project ? [{ params: { slug: card.slug }, props: { project } }] : [];
  });
}

const { slug } = Astro.params;
const { project } = Astro.props as { project: Project };
const site = getSite();
const ui = site.ui;
const done = project.progress.filter((item) => item.status === 'done').length;
const stats = [
  { label: ui.project.completed, value: `${done} of ${project.progress.length}` },
  { label: ui.project.nextStep, value: project.summary.nextStep },
  { label: ui.project.openQuestions, value: String(project.summary.openQuestions) },
  { label: ui.project.tagsMapped, value: String(project.summary.tagsMapped) },
];
const logo = { src: site.logo.light, alt: site.logo.alt };
const accents = ['#00dcfa', '#2ca9f5', '#3c7af0', '#5a5cf8', '#7543ff'];
---
<BaseLayout title={project.title} noindex>
  <div class="banner">{ui.internalBanner}</div>

  <header class="proj-head on-dark">
    <div class="container">
      <div class="top">
        <a href={url()} aria-label={ui.homeAria} class="brand">
          <img src={url(logo.src)} alt={logo.alt} height="28" />
        </a>
        <nav class="views" aria-label={ui.viewsNavAria}>
          <a href={url(`products/${slug}/`)}>{ui.productTab}</a>
          <a href={url(`products/${slug}/project/`)} aria-current="page">{ui.projectTab}</a>
        </nav>
      </div>

      <div class="title">
        <h1>{project.title}</h1>
        <p class="meta">
          {fill(ui.project.meta, {
            designVersion: project.meta.designVersion,
            pilot: project.meta.pilot,
            updated: project.meta.updated,
          })}
        </p>
      </div>

      <div class="stats">
        {stats.map((stat) => (
          <div class="stat">
            <span class="stat-label">{stat.label}</span>
            <span class="stat-value">{stat.value}</span>
          </div>
        ))}
      </div>
    </div>
  </header>

  <main id="main" class="body">
    <div class="container">
      <section class="block">
        <ProgressList progress={project.progress} statusLabels={project.statusLabels} ui={ui.project} />
      </section>

      <section class="block split">
        <div class="col">
          <h2>{ui.project.inScope}</h2>
          <ul class="card-list">
            {project.scope.in.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="col">
          <h2>
            {ui.project.outOfScope}
            {project.scope.outDraft && <span class="draft">{ui.project.draftNote}</span>}
          </h2>
          <ul class="card-list">
            {project.scope.out.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section class="block">
        <h2>{ui.project.architecture}</h2>
        <ol class="arch">
          {project.architecture.map((step, index) => (
            <li class="arch-step" style={`--accent: ${accents[index % accents.length]}`}>
              <span class="arch-name">{index + 1}. {step.name}</span>
              <span class="arch-body">
                {step.body.split(/(`[^`]+`)/).map((part) =>
                  part.startsWith('`') ? <code>{part.slice(1, -1)}</code> : part,
                )}
              </span>
            </li>
          ))}
        </ol>
      </section>

      <section class="block">
        <h2>{ui.project.decisions}</h2>
        <div class="decisions">
          {project.decisions.map((decision) => (
            <p><b>{decision.id}</b> {decision.text}</p>
          ))}
        </div>
      </section>

      <section class="block">
        <h2>{ui.project.openQuestions}</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">{ui.project.colNumber}</th>
                <th scope="col">{ui.project.colQuestion}</th>
                <th scope="col">{ui.project.colRecommendation}</th>
              </tr>
            </thead>
            <tbody>
              {project.questions.map((question) => (
                <tr>
                  <td>{question.id}</td>
                  <td>{question.question}</td>
                  <td>{question.recommendation}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>

  <Footer homeHref={url()} homeAria={ui.homeAria} logo={logo} legal={site.footer.legal} />
</BaseLayout>

<style>
  .banner {
    padding: 12px 24px;
    background: var(--indigo);
    color: var(--on-dark);
    font-size: 15px;
    text-align: center;
  }

  .proj-head {
    background: var(--night);
    padding: 28px 0 56px;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .brand img {
    height: 28px;
    width: auto;
  }

  .views {
    display: flex;
    gap: 6px;
    padding: 6px;
    background: var(--panel-dark);
    border-radius: var(--radius-pill);
  }

  .views a {
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    color: var(--on-dark-soft);
    text-decoration: none;
  }

  .views a[aria-current='page'] {
    background: var(--signal);
    color: var(--night);
    font-weight: 500;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 40px;
  }

  h1 {
    font-size: clamp(36px, 4.4vw, 56px);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--on-dark);
  }

  .meta {
    font-size: 18px;
    color: var(--on-dark-muted);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 40px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 24px;
    background: var(--panel-dark);
    border-radius: 18px;
  }

  .stat-label {
    font-size: 14px;
    color: var(--on-dark-muted);
  }

  .stat-value {
    font-size: 26px;
    font-weight: 300;
    color: var(--on-dark);
  }

  .body {
    padding: 72px 0 96px;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 72px;
  }

  h2 {
    font-size: 32px;
    font-weight: 600;
    color: var(--ink);
  }

  .draft {
    margin-left: 12px;
    font-size: 16px;
    font-weight: 400;
    color: var(--muted);
  }

  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
  }

  .col {
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card-list {
    padding: 28px 28px 28px 48px;
    background: var(--white);
    border-radius: var(--radius-card);
    font-size: 16px;
    line-height: 1.9;
    color: var(--body);
  }

  .arch {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .arch-step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--white);
    border-radius: 20px;
    border-top: 4px solid var(--accent);
  }

  .arch-name {
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
  }

  .arch-body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  code {
    padding: 1px 6px;
    border-radius: 6px;
    background: #e4edf8;
    color: var(--deep);
    font-family: ui-monospace, Consolas, monospace;
    font-size: 14px;
    font-weight: 500;
  }

  .decisions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 0 40px;
    padding: 12px 32px;
    background: var(--white);
    border-radius: var(--radius-card);
  }

  .decisions p {
    padding: 16px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
  }

  .decisions b {
    color: var(--ink);
    font-weight: 600;
  }

  .table-wrap {
    overflow-x: auto;
    background: var(--white);
    border-radius: var(--radius-card);
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.5;
    color: var(--body);
  }

  th,
  td {
    padding: 14px 24px;
    border-bottom: 1px solid var(--line-soft);
    text-align: left;
    vertical-align: top;
  }

  th {
    padding-top: 18px;
    padding-bottom: 18px;
    border-bottom: 2px solid var(--line);
    color: var(--ink);
    font-weight: 600;
  }

  td:first-child {
    width: 72px;
    color: var(--ink);
  }

  @media (max-width: 760px) {
    h2 {
      font-size: 26px;
    }

    .block {
      margin-bottom: 56px;
    }
  }
</style>
