---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Footer from '../../../../components/Footer.astro';
import ProjectBoard from '../../../../components/ProjectBoard.astro';
import { getProject, getSite } from '../../../../lib/data';
import { isPublicBuild, url } from '../../../../lib/paths';
import type { Project } from '../../../../lib/schema';

// Internal only: no pages at all in public builds (SPEC §5)
export function getStaticPaths() {
  if (isPublicBuild) return [];
  return getSite().products.flatMap((card) => {
    if (card.status !== 'available') return [];
    const project = getProject(card.slug);
    return project ? [{ params: { slug: card.slug }, props: { project } }] : [];
  });
}

const { slug } = Astro.params;
const { project } = Astro.props as { project: Project };
const site = getSite();
const ui = site.ui;
const logo = { src: site.logo.light, alt: site.logo.alt };
---
<BaseLayout title={project.title} noindex>
  <div class="banner">{ui.internalBanner}</div>

  <ProjectBoard
    project={project}
    ui={ui.project}
    slug={slug}
    logo={logo}
    homeAria={ui.homeAria}
    viewsNavAria={ui.viewsNavAria}
    productTab={ui.productTab}
    projectTab={ui.projectTab}
  />

  <Footer homeHref={url()} homeAria={ui.homeAria} logo={logo} legal={site.footer.legal} />
</BaseLayout>

<style>
  .banner {
    padding: 12px 24px;
    background: var(--indigo);
    color: var(--on-dark);
    font-size: 15px;
    text-align: center;
  }
</style>
