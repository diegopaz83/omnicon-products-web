---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { getProject, getSite } from '../lib/data';
import { isPublicBuild, url } from '../lib/paths';
import { fill } from '../lib/text';

const site = getSite();
const available = site.products.filter((card) => card.status === 'available');
const placeholders = site.products.filter((card) => card.status !== 'available');
// Project links exist only in internal builds
const hasProjectView = (slug: string) => !isPublicBuild && getProject(slug) !== null;
---
<BaseLayout title={site.name} description={site.hero.subtitle}>
  <Header
    brandHref={url()}
    brandAria={site.ui.homeAria}
    logo={{ src: site.logo.light, alt: site.logo.alt }}
    navAria={site.ui.mainNavAria}
    nav={site.nav}
    cta={{ label: site.ui.talkToUs, href: '#contact' }}
  />

  <main id="main">
    <section class="hero on-dark" style={`--hero-art: url('${url(site.hero.background)}')`}>
      <div class="container">
        <p class="label">{site.hero.label}</p>
        <h1>{site.hero.title}</h1>
        <p class="subtitle">{site.hero.subtitle}</p>
      </div>
    </section>

    <section id="products" class="cards">
      <div class="container stack">
        {available.map((card) => (
          <article class="card">
            <div class="info">
              <div class="tags">
                <span class="status">{card.statusLabel}</span>
                <span class="category">{card.category}</span>
              </div>
              <h2>{card.name}</h2>
              <p class="summary">{card.summary}</p>
              <ul class="highlights">
                {card.highlights.map((item) => <li>{item}</li>)}
              </ul>
              <div class="actions">
                <a class="btn btn-action" href={url(`products/${card.slug}/`)}>
                  {fill(site.ui.explore, { name: card.name })}
                </a>
                {hasProjectView(card.slug) && (
                  <a class="btn btn-soft" href={url(`products/${card.slug}/project/`)}>
                    {site.ui.projectView}
                  </a>
                )}
              </div>
            </div>
            <div class="visual">
              <img src={url(card.image.src)} alt={card.image.alt} width="1200" height="900" loading="lazy" />
            </div>
          </article>
        ))}

        <div class="tiles">
          {placeholders.map((card) => (
            <article class="tile">
              {card.image && (
                <div class="tile-visual">
                  <img src={url(card.image.src)} alt={card.image.alt} width="1200" height="750" loading="lazy" />
                </div>
              )}
              <div class="tile-info">
                <div class="tags">
                  <span class="status pending">{card.statusLabel}</span>
                  {card.category && <span class="category">{card.category}</span>}
                </div>
                <h3>{card.name}</h3>
                <p>{card.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="about section">
      <div class="container split">
        <div class="copy">
          <h2>{site.about.title}</h2>
          <p>{site.about.body}</p>
        </div>
        <img class="photo" src={url(site.about.image.src)} alt={site.about.image.alt} width="1200" height="680" loading="lazy" />
      </div>
    </section>

    <CtaBand title={site.cta.title} body={site.cta.body} button={site.cta.button} href={site.cta.href} />
  </main>

  <Footer homeHref={url()} homeAria={site.ui.homeAria} logo={{ src: site.logo.light, alt: site.logo.alt }} legal={site.footer.legal} />
</BaseLayout>

<style>
  .hero {
    background: var(--night) var(--hero-art, none) right -120px bottom -60px / 980px auto no-repeat;
    padding: 96px 0 200px;
  }

  .label {
    font-size: 16px;
    font-weight: 500;
    color: var(--signal);
  }

  h1 {
    margin-top: 28px;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 15ch;
    color: var(--on-dark);
  }

  .subtitle {
    margin-top: 28px;
    font-size: 20px;
    line-height: 1.6;
    color: var(--on-dark-muted);
    max-width: 56ch;
  }

  .cards {
    padding: 0 0 var(--section-y);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: -120px;
  }

  .card {
    display: flex;
    flex-wrap: wrap;
    background: var(--white);
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 28, 63, 0.18);
  }

  .info {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 56px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .status {
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--ok-bg);
    color: var(--ok-fg);
    font-size: 14px;
    font-weight: 500;
  }

  .category {
    font-size: 14px;
    color: var(--muted);
  }

  h2 {
    font-size: 44px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--ink);
  }

  .summary {
    font-size: 20px;
    line-height: 1.55;
    max-width: 44ch;
    color: var(--body);
  }

  .highlights {
    padding-left: 20px;
    font-size: 17px;
    line-height: 1.9;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .visual {
    position: relative;
    flex: 1 1 420px;
    min-height: 360px;
    background: var(--night);
  }

  .visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
  }

  .btn-soft {
    background: var(--chip);
    color: var(--deep);
    border-color: transparent;
  }

  .btn-soft:hover {
    color: var(--night);
    background: #c4ddf7;
  }

  .tile {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 28, 63, 0.1);
  }

  .tile-visual {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--night);
  }

  .tile-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    opacity: 0.55;
  }

  .tile-info {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .status.pending {
    background: var(--status-idle-bg);
    color: var(--status-idle-fg);
  }

  .tile h3 {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }

  .tile p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }

  .about {
    background: var(--white);
  }

  .split {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
  }

  .copy {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about h2 {
    font-size: 36px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .about p {
    font-size: 18px;
    line-height: 1.7;
    max-width: 52ch;
    color: var(--body);
  }

  .photo {
    flex: 1 1 420px;
    min-width: 0;
    width: 100%;
    height: 340px;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  @media (max-width: 760px) {
    .hero {
      background-size: 600px auto;
      padding: 72px 0 150px;
    }

    .stack {
      margin-top: -72px;
    }

    .info {
      padding: 28px;
    }

    h2 {
      font-size: 32px;
    }
  }
</style>
