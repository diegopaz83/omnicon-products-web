---
import { url } from '../lib/paths';

interface Props {
  title: string;
  src: string;
  enlarge: string;
  restore: string;
}

const { title, src, enlarge, restore } = Astro.props;
---
<div class="twin" data-twin data-src={url(src)}>
  <div class="frame">
    <iframe title={title} data-frame></iframe>
  </div>
  <button
    type="button"
    class="btn btn-ghost-dark toggle"
    data-toggle
    data-enlarge={enlarge}
    data-restore={restore}
    aria-expanded="false"
  >{enlarge}</button>
</div>

<script>
  const twin = document.querySelector<HTMLElement>('[data-twin]');

  if (twin) {
    const frame = twin.querySelector<HTMLIFrameElement>('[data-frame]');
    const toggle = twin.querySelector<HTMLButtonElement>('[data-toggle]');
    const src = twin.dataset.src ?? '';

    // Load the 3D scene only when the block gets close to the viewport
    const load = () => {
      if (frame && !frame.src) frame.src = src;
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            load();
            observer.disconnect();
          }
        },
        { rootMargin: '200px' },
      );
      observer.observe(twin);
    } else {
      load();
    }

    const setExpanded = (on: boolean) => {
      twin.classList.toggle('expanded', on);
      document.body.classList.toggle('twin-open', on);
      if (toggle) {
        toggle.setAttribute('aria-expanded', String(on));
        toggle.textContent = on ? toggle.dataset.restore ?? '' : toggle.dataset.enlarge ?? '';
      }
      if (on) load();
    };

    toggle?.addEventListener('click', () => {
      const expanded = twin.classList.contains('expanded');
      setExpanded(!expanded);
      if (expanded) toggle.focus();
    });

    // Escape restores the normal size
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && twin.classList.contains('expanded')) {
        setExpanded(false);
        toggle?.focus();
      }
    });
  }
</script>

<style>
  .twin {
    position: relative;
    margin-bottom: 24px;
  }

  .frame {
    height: 560px;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: #071a2d;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .toggle {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    min-height: 40px;
    padding: 10px 18px;
    background: rgba(4, 23, 43, 0.85);
  }

  .twin.expanded {
    position: fixed;
    inset: 0;
    z-index: 100;
    margin: 0;
    background: #001023;
  }

  .twin.expanded .frame {
    height: 100%;
    border-radius: 0;
  }

  :global(body.twin-open) {
    overflow: hidden;
  }

  @media (max-width: 760px) {
    .frame {
      height: 440px;
    }
  }
</style>
