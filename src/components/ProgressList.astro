---
import type { Project, Site } from '../lib/schema';

interface Props {
  progress: Project['progress'];
  statusLabels: Project['statusLabels'];
  ui: Site['ui']['project'];
}

const { progress, statusLabels, ui } = Astro.props;
const done = progress.filter((item) => item.status === 'done').length;
const percent = Math.round((done / progress.length) * 100);
const filters = [
  { key: 'all', label: ui.all },
  { key: 'done', label: ui.done },
  { key: 'open', label: ui.pending },
];
---
<div class="progress" data-progress>
  <div class="head">
    <h2>{ui.progress}</h2>
    <div class="filters" role="group" aria-label={ui.progress}>
      {filters.map((filter, index) => (
        <button type="button" class="filter" data-filter={filter.key} aria-pressed={index === 0 ? 'true' : 'false'}>
          {filter.label}
        </button>
      ))}
    </div>
  </div>
  <div class="bar" aria-hidden="true">
    <div class="fill" style={`width: ${percent}%`}></div>
  </div>
  <ol class="list">
    {progress.map((item) => (
      <li class="item" data-state={item.status === 'done' ? 'done' : 'open'}>
        <span class="code">{item.code}</span>
        <span class="text">
          <span class="name">{item.name}</span>
          <span class="detail">{item.detail}</span>
        </span>
        <span class:list={['pill', item.status]}>{statusLabels[item.status]}</span>
      </li>
    ))}
  </ol>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-progress]');
  if (root) {
    const filters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('.item'));

    // Show items that match the filter; "open" means not done
    const apply = (filter: string) => {
      filters.forEach((button) =>
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter)),
      );
      items.forEach((item) => {
        const state = item.dataset.state;
        item.hidden = !(filter === 'all' || filter === state);
      });
    };

    filters.forEach((button) =>
      button.addEventListener('click', () => apply(button.dataset.filter ?? 'all')),
    );
  }
</script>

<style>
  .progress {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }

  h2 {
    font-size: 32px;
    font-weight: 600;
    color: var(--ink);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter {
    min-height: 44px;
    padding: 9px 16px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
  }

  .filter[aria-pressed='true'] {
    background: var(--night);
    border-color: var(--night);
    color: var(--on-dark);
  }

  .bar {
    height: 12px;
    border-radius: 6px;
    background: var(--line);
    overflow: hidden;
  }

  .fill {
    height: 12px;
    background: linear-gradient(90deg, var(--signal), var(--volt));
  }

  .list {
    list-style: none;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding: 20px 28px;
    border-bottom: 1px solid var(--line-soft);
  }

  .item[hidden] {
    display: none;
  }

  .code {
    flex: 0 0 48px;
    font-size: 15px;
    color: var(--muted);
  }

  .text {
    flex: 1 1 260px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .name {
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
  }

  .detail {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  .pill {
    flex: 0 0 auto;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 600;
    background: var(--status-idle-bg);
    color: var(--status-idle-fg);
  }

  .pill.done {
    background: var(--ok-bg);
    color: var(--ok-fg);
  }

  .pill.next,
  .pill.in-progress {
    background: var(--status-next-bg);
    color: var(--status-next-fg);
  }

  .pill.blocked {
    background: var(--fault);
    color: var(--night);
  }

  @media (max-width: 760px) {
    h2 {
      font-size: 26px;
    }

    .item {
      padding: 18px 20px;
    }
  }
</style>
