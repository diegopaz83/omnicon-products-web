---
import type { Product } from '../../lib/schema';

interface Props {
  product: Product;
}

const { rollup } = Astro.props.product;
---
{rollup && (
  <section class="section rollup">
    <div class="container grid">
      <div class="copy">
        <h2>{rollup.title}</h2>
        <p class="body">{rollup.body}</p>
        <ul class="cuts">
          {rollup.cuts.map((cut) => <li>{cut}</li>)}
        </ul>
      </div>
      <ol class="levels">
        {rollup.levels.map((level, index) => (
          <li class:list={['level', { top: index === rollup.levels.length - 1 }]} style={`--indent: ${index * 28}px`}>
            <span class="level-name">{level.name}</span>
            <span class="level-body">{level.body}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .rollup {
    background: var(--paper);
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
  }

  .copy {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h2 {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .body {
    font-size: 18px;
    line-height: 1.65;
    color: var(--body);
  }

  .cuts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
    list-style: none;
  }

  .cuts li {
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    background: var(--chip);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
  }

  .levels {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
  }

  .level {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: var(--indent);
    padding: 24px 28px;
    background: var(--white);
    border-radius: 20px;
  }

  .level.top {
    background: var(--night);
  }

  .level-name {
    flex: 0 0 96px;
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
  }

  .level-body {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }

  .level.top .level-name {
    color: var(--on-dark);
  }

  .level.top .level-body {
    color: var(--on-dark-soft);
  }

  @media (max-width: 760px) {
    h2 {
      font-size: 32px;
    }

    .level {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .level-name {
      flex: none;
    }
  }
</style>
