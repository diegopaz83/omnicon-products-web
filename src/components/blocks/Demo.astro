---
import { getSite } from '../../lib/data';
import { fill } from '../../lib/text';
import { INITIAL_STATE, computeMetrics, machineStatus, messageKey } from '../../lib/demo';
import type { Product } from '../../lib/schema';

interface Props {
  product: Product;
}

const { demo } = Astro.props.product;
const { ui } = getSite();

const metrics = demo ? computeMetrics(demo, INITIAL_STATE) : null;
// Shared with the client script: formulas and copy stay in one place
const config = demo ? { demo, ui: ui.demo, twin: ui.twin } : null;
---
{demo && metrics && (
  <section id="demo" class="section demo on-dark">
    <div class="container">
      <header class="head">
        <div class="copy">
          <h2>{demo.title}</h2>
          <p>{demo.intro}</p>
        </div>
        <p class="disclaimer">{demo.disclaimer}</p>
      </header>

      <div class="stage" data-stage>
        <div class="bar">
          <button type="button" class="btn btn-ghost-dark toggle" data-toggle aria-expanded="false" data-enlarge={ui.twin.enlarge} data-restore={ui.twin.restore}>{ui.twin.enlarge}</button>
        </div>

        <div class="view">
          <div class="scene" data-scene role="img" aria-label={ui.twin.title}></div>

          <aside class="hud-top">
            <p class="oee-label">{ui.demo.lineOee}</p>
            <p class="oee" data-oee>{metrics.oee}%</p>
            <div class="bars">
              {[
                { key: 'availability', label: ui.demo.availability, value: metrics.availability, color: 'var(--action)' },
                { key: 'performance', label: ui.demo.performance, value: metrics.performance, color: 'var(--indigo)' },
                { key: 'quality', label: ui.demo.quality, value: metrics.quality, color: 'var(--volt)' },
              ].map((bar) => (
                <div class="bar-row">
                  <div class="bar-head">
                    <span>{bar.label}</span>
                    <span data-metric={bar.key}>{bar.value}%</span>
                  </div>
                  <div class="track">
                    <div class="fill" data-fill={bar.key} style={`width: ${bar.value}%; background: ${bar.color}`}></div>
                  </div>
                </div>
              ))}
            </div>
            <ul class="machine-list">
              {demo.machines.map((machine) => (
                <li>
                  <span>{machine.name}</span>
                  <span class:list={['pill', machineStatus(demo, INITIAL_STATE, machine.name)]} data-machine={machine.name}>
                    {machineStatus(demo, INITIAL_STATE, machine.name) === 'faulted' ? ui.demo.faulted : ui.demo.running}
                  </span>
                </li>
              ))}
            </ul>
            <div class="totals">
              <span>{fill(ui.demo.scheduled, { minutes: demo.shiftMinutes })}</span>
              <span data-unplanned-total>{fill(ui.demo.unplannedStops, { minutes: metrics.unplanned })}</span>
              <span data-planned-total>{fill(ui.demo.plannedStops, { minutes: metrics.planned })}</span>
            </div>
          </aside>

          <div class="hud-bottom">
            <div class="controls">
              <button type="button" class="btn btn-fault" data-fault>{demo.fault.button}</button>
              <button type="button" class="btn btn-ghost-dark" data-reset hidden>{demo.reset}</button>
              <p class="message" data-message aria-live="polite">{demo.messages[messageKey(demo, INITIAL_STATE)]}</p>
            </div>

            <div class="prompt" data-prompt hidden>
              <p>{demo.fault.prompt}</p>
              <div class="reasons">
                {demo.reasons.map((reason) => (
                  <button type="button" class="btn btn-reason" data-reason={reason.id}>{reason.label}</button>
                ))}
              </div>
            </div>

            <div class="events">
              <h3>{ui.demo.events}</h3>
              <div class="rows" data-events>
                {demo.seedEvents.map((event) => (
                  <div class="ev">
                    <span class="ev-time">{event.time}</span>
                    <span class="ev-machine">{event.machine}</span>
                    <span class="ev-minutes">{fill(ui.demo.minutes, { minutes: event.minutes })}</span>
                    <span class="ev-reason">{event.reason}</span>
                    <span class="ev-kind">{event.planned ? ui.demo.planned : ui.demo.unplanned}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

{config && <script type="application/json" id="demo-config" is:inline set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />}

<script>
  import { INITIAL_STATE, computeMetrics, machineStatus, messageKey } from '../../lib/demo';
  import type { Demo, DemoState } from '../../lib/demo';
  import { fill } from '../../lib/text';
  import type { Twin } from '../../lib/twin/scene';

  const root = document.querySelector<HTMLElement>('#demo');
  const configEl = document.getElementById('demo-config');

  if (root && configEl?.textContent) {
    const { demo, ui, twin: twinUi } = JSON.parse(configEl.textContent) as {
      demo: Demo;
      ui: Record<string, string>;
      twin: { enlarge: string; restore: string };
    };
    let state: DemoState = { ...INITIAL_STATE };

    const q = <T extends Element>(selector: string) => root.querySelector<T>(selector);
    const el = (tag: string, className: string, text: string) => {
      const node = document.createElement(tag);
      node.className = className;
      node.textContent = text;
      return node;
    };

    // Scene mounts once, when the stage gets close to the viewport
    let twin: Twin | null = null;
    let mounting = false;

    const syncTwin = () => {
      if (!twin) return;
      const machines = Object.fromEntries(
        demo.machines.map((machine) => [machine.id, machineStatus(demo, state, machine.name)]),
      ) as Record<string, 'running' | 'faulted'>;
      twin.update({ machines: machines as Record<'m1' | 'm2' | 'm3', 'running' | 'faulted'>, running: true });
    };

    const mount = async () => {
      const scene = q<HTMLElement>('[data-scene]');
      if (!scene || twin || mounting) return;
      mounting = true;
      const { mountTwin } = await import('../../lib/twin/scene');
      twin = scene ? mountTwin(scene) : null;
      mounting = false;
      syncTwin();
    };

    const scene = q<HTMLElement>('[data-scene]');
    if (scene && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            mount();
            observer.disconnect();
          }
        },
        { rootMargin: '200px' },
      );
      observer.observe(scene);
    } else {
      mount();
    }

    const renderMachines = () => {
      root.querySelectorAll<HTMLElement>('[data-machine]').forEach((pill) => {
        const faulted = machineStatus(demo, state, pill.dataset.machine ?? '') === 'faulted';
        pill.classList.toggle('faulted', faulted);
        pill.classList.toggle('running', !faulted);
        pill.textContent = faulted ? ui.faulted : ui.running;
      });
    };

    const renderControls = () => {
      const fault = q<HTMLButtonElement>('[data-fault]');
      const reset = q<HTMLButtonElement>('[data-reset]');
      const prompt = q<HTMLElement>('[data-prompt]');
      const message = q<HTMLElement>('[data-message]');
      if (fault) fault.hidden = state.fault;
      if (reset) reset.hidden = !state.fault;
      if (prompt) prompt.hidden = !(state.fault && !state.reason);
      if (message) message.textContent = demo.messages[messageKey(demo, state)];
    };

    // Seed events plus the breakdown while it is active
    const renderEvents = () => {
      const container = q<HTMLElement>('[data-events]');
      if (!container) return;

      const rows = demo.seedEvents.map((event) => ({
        time: event.time,
        machine: event.machine,
        minutes: event.minutes,
        reason: event.reason,
        planned: event.planned,
        unknown: false,
      }));
      if (state.fault) {
        const reason = demo.reasons.find((item) => item.id === state.reason);
        rows.push({
          time: demo.fault.time,
          machine: demo.fault.machine,
          minutes: demo.fault.minutes,
          reason: reason?.label ?? ui.unknown,
          planned: !!reason?.planned,
          unknown: !reason,
        });
      }

      container.replaceChildren(
        ...rows.map((row) => {
          const line = el('div', 'ev', '');
          line.append(
            el('span', 'ev-time', row.time),
            el('span', 'ev-machine', row.machine),
            el('span', 'ev-minutes', fill(ui.minutes, { minutes: row.minutes })),
            el('span', row.unknown ? 'ev-reason ev-unknown' : 'ev-reason', row.reason),
            el('span', 'ev-kind', row.planned ? ui.planned : ui.unplanned),
          );
          return line;
        }),
      );
    };

    const renderMetrics = () => {
      const metrics = computeMetrics(demo, state);
      const oee = q<HTMLElement>('[data-oee]');
      if (oee) oee.textContent = `${metrics.oee}%`;

      for (const key of ['availability', 'performance', 'quality'] as const) {
        const value = metrics[key];
        const label = q<HTMLElement>(`[data-metric="${key}"]`);
        const fillBar = q<HTMLElement>(`[data-fill="${key}"]`);
        if (label) label.textContent = `${value}%`;
        if (fillBar) fillBar.style.width = `${value}%`;
      }

      const unplanned = q<HTMLElement>('[data-unplanned-total]');
      const planned = q<HTMLElement>('[data-planned-total]');
      if (unplanned) unplanned.textContent = fill(ui.unplannedStops, { minutes: metrics.unplanned });
      if (planned) planned.textContent = fill(ui.plannedStops, { minutes: metrics.planned });
    };

    const render = () => {
      renderMachines();
      renderControls();
      renderEvents();
      renderMetrics();
      syncTwin();
    };

    // Move focus to the next control so keyboard users keep their place
    q<HTMLButtonElement>('[data-fault]')?.addEventListener('click', () => {
      state = { fault: true, reason: null };
      render();
      q<HTMLButtonElement>('[data-reason]')?.focus();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-reason]').forEach((button) => {
      button.addEventListener('click', () => {
        state = { ...state, reason: button.dataset.reason ?? null };
        render();
        q<HTMLButtonElement>('[data-reset]')?.focus();
      });
    });

    q<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => {
      state = { ...INITIAL_STATE };
      render();
      q<HTMLButtonElement>('[data-fault]')?.focus();
    });

    // Enlarge the whole stage; the toolbar stays outside the scene
    const stage = q<HTMLElement>('[data-stage]');
    const toggle = q<HTMLButtonElement>('[data-toggle]');
    const setExpanded = (on: boolean) => {
      stage?.classList.toggle('expanded', on);
      document.body.classList.toggle('twin-open', on);
      if (toggle) {
        toggle.setAttribute('aria-expanded', String(on));
        toggle.textContent = on ? twinUi.restore : twinUi.enlarge;
      }
    };
    toggle?.addEventListener('click', () => {
      const expanded = !!stage?.classList.contains('expanded');
      setExpanded(!expanded);
      toggle.focus();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && stage?.classList.contains('expanded')) {
        setExpanded(false);
        toggle?.focus();
      }
    });
  }
</script>

<style>
  .demo {
    background: var(--night);
  }

  .container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 640px;
  }

  h2 {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--on-dark);
  }

  .copy p {
    font-size: 18px;
    line-height: 1.65;
    color: var(--on-dark-muted);
  }

  .disclaimer {
    font-size: 14px;
    color: var(--on-dark-faint);
  }

  .stage {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bar {
    display: flex;
    justify-content: flex-end;
  }

  .toggle {
    min-height: 40px;
    padding: 10px 18px;
    background: rgba(4, 23, 43, 0.9);
  }

  .view {
    position: relative;
    height: 640px;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #071a2d;
  }

  .scene {
    position: absolute;
    inset: 0;
  }

  .scene :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hud-top {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    background: rgba(4, 23, 43, 0.88);
    border: 1px solid #285476;
    border-radius: 14px;
    color: var(--on-dark);
  }

  .oee-label {
    font-size: 14px;
    color: var(--on-dark-muted);
  }

  .oee {
    font-size: 56px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--signal);
  }

  .bars {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .bar-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
  }

  .bar-head {
    display: flex;
    justify-content: space-between;
  }

  .track {
    height: 8px;
    border-radius: 4px;
    background: #163451;
    overflow: hidden;
  }

  .fill {
    height: 8px;
    border-radius: 4px;
    transition: width 0.3s ease;
  }

  .machine-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--line-dark);
    font-size: 14px;
  }

  .machine-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pill {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-weight: 600;
    background: var(--signal);
    color: var(--night);
  }

  .pill.faulted {
    background: var(--fault);
  }

  .totals {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--on-dark-muted);
  }

  .hud-bottom {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 42%;
    overflow-y: auto;
    padding: 16px 20px;
    background: rgba(4, 23, 43, 0.9);
    border: 1px solid #285476;
    border-radius: 14px;
    color: var(--on-dark);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .message {
    flex: 1 1 280px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--on-dark-soft);
  }

  .prompt {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .prompt p {
    font-size: 16px;
    font-weight: 600;
  }

  .reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .btn-reason {
    min-height: 44px;
    padding: 12px 18px;
    border: 0;
    background: var(--on-dark);
    color: var(--night);
    font-size: 15px;
    font-weight: 500;
  }

  .events h3 {
    font-size: 16px;
    font-weight: 600;
  }

  .rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line-dark);
  }

  .ev {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line-dark);
    font-size: 14px;
  }

  .ev-time,
  .ev-minutes,
  .ev-kind {
    color: var(--on-dark-muted);
  }

  .ev-time {
    flex: 0 0 60px;
  }

  .ev-machine {
    flex: 1 1 110px;
    font-weight: 500;
  }

  .ev-minutes {
    flex: 0 0 64px;
  }

  .ev-reason {
    flex: 1 1 150px;
    font-weight: 500;
  }

  .ev-kind {
    flex: 0 0 80px;
  }

  .ev-unknown {
    color: var(--fault);
  }

  /* Enlarged: fills the screen; the toolbar sits above the scene */
  .stage.expanded {
    position: fixed;
    inset: 0;
    z-index: 100;
    gap: 0;
    background: #001023;
  }

  .stage.expanded .bar {
    padding: 12px 16px;
    background: #04172b;
  }

  .stage.expanded .view {
    flex: 1;
    height: auto;
    border-radius: 0;
  }

  :global(body.twin-open) {
    overflow: hidden;
  }

  @media (max-width: 760px) {
    h2 {
      font-size: 32px;
    }

    .view {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 0;
      overflow: visible;
      background: transparent;
    }

    .scene {
      position: relative;
      inset: auto;
      height: 340px;
      border-radius: var(--radius-card);
      overflow: hidden;
    }

    .stage.expanded .view {
      overflow-y: auto;
    }

    .stage.expanded .scene {
      height: 60vh;
    }

    .hud-top,
    .hud-bottom {
      position: static;
      width: auto;
      max-height: none;
    }

    .oee {
      font-size: 44px;
    }
  }
</style>
