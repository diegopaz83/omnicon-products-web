---
import { getSite } from '../../lib/data';
import { fill } from '../../lib/text';
import { INITIAL_STATE, computeMetrics, currentReason, faultTime, machineStatus, messageKey } from '../../lib/demo';
import type { Product } from '../../lib/schema';

interface Props {
  product: Product;
}

const { demo } = Astro.props.product;
const { ui } = getSite();

const metrics = demo ? computeMetrics(demo, INITIAL_STATE) : null;
// Shared with the client script: formulas and copy stay in one place
const config = demo ? { demo, ui: ui.demo, twin: ui.twin } : null;
---
{demo && metrics && (
  <section id="demo" class="section demo on-dark">
    <div class="container">
      <header class="head">
        <div class="copy">
          <h2>{demo.title}</h2>
          <p>{demo.intro}</p>
        </div>
        <p class="disclaimer">{demo.disclaimer}</p>
      </header>

      <div class="stage" data-stage>
        <div class="bar">
          <button type="button" class="btn btn-ghost-dark toggle" data-overview>{ui.demo.overview}</button>
          <button type="button" class="btn btn-ghost-dark toggle" data-toggle aria-expanded="false" data-enlarge={ui.twin.enlarge} data-restore={ui.twin.restore}>{ui.twin.enlarge}</button>
        </div>

        <div class="view">
          <div class="scene" data-scene role="img" aria-label={ui.twin.title}>
            {demo.machines.map((machine) => (
              <div class="tag" data-tag={machine.id}>
                <span class="tag-name">{machine.name}: {machine.station}</span>
                <span class="tag-state" data-tag-state>{ui.demo.running}</span>
              </div>
            ))}
          </div>

          <aside class="hud-top">
            <p class="oee-label">{ui.demo.lineOee}</p>
            <p class="oee" data-oee>{metrics.oee}%</p>
            <div class="bars">
              {[
                { key: 'availability', label: ui.demo.availability, value: metrics.availability, color: 'var(--action)' },
                { key: 'performance', label: ui.demo.performance, value: metrics.performance, color: 'var(--indigo)' },
                { key: 'quality', label: ui.demo.quality, value: metrics.quality, color: 'var(--volt)' },
              ].map((bar) => (
                <div class="bar-row">
                  <div class="bar-head">
                    <span>{bar.label}</span>
                    <span data-metric={bar.key}>{bar.value}%</span>
                  </div>
                  <div class="track">
                    <div class="fill" data-fill={bar.key} style={`width: ${bar.value}%; background: ${bar.color}`}></div>
                  </div>
                </div>
              ))}
            </div>
            <ul class="machine-list">
              {demo.machines.map((machine) => (
                <li>
                  <span>{machine.name}</span>
                  <span class:list={['pill', machineStatus(demo, INITIAL_STATE, machine.name)]} data-machine={machine.name}>
                    {machineStatus(demo, INITIAL_STATE, machine.name) === 'faulted' ? ui.demo.faulted : ui.demo.running}
                  </span>
                </li>
              ))}
            </ul>
            <div class="totals">
              <span>{fill(ui.demo.scheduled, { minutes: demo.shiftMinutes })}</span>
              <span data-unplanned-total>{fill(ui.demo.unplannedStops, { minutes: metrics.unplanned })}</span>
              <span data-planned-total>{fill(ui.demo.plannedStops, { minutes: metrics.planned })}</span>
            </div>
          </aside>

          <div class="hud-bottom">
            <ol class="steps" data-steps>
              {ui.demo.steps.map((label, index) => (
                <li class:list={["step", { current: index === 0 }]} data-step={index}>
                  <span class="step-num">{index + 1}</span>
                  <span>{label}</span>
                </li>
              ))}
            </ol>

            <div class="controls">
              <button type="button" class="btn btn-fault" data-fault>{demo.fault.button}</button>
              <button type="button" class="btn btn-signal" data-restart hidden>{ui.demo.restart}</button>
              <p class="message" data-message aria-live="polite">{demo.messages[messageKey(demo, INITIAL_STATE)]}</p>
            </div>

            <div class="prompt" data-prompt hidden>
              <p>{demo.fault.prompt}</p>
              <div class="reasons">
                {demo.reasons.map((reason) => (
                  <button type="button" class="btn btn-reason" data-reason={reason.id}>{reason.label}</button>
                ))}
              </div>
            </div>

            <div class="events">
              <h3>{ui.demo.events}</h3>
              <ul class="chips" data-events>
                {demo.seedEvents.map((event) => (
                  <li class="chip">
                    <span class="chip-time">{event.time}</span>
                    <span class="chip-machine">{event.machine}</span>
                    <span>{fill(ui.demo.minutes, { minutes: event.minutes })}</span>
                    <span class="chip-reason">{event.reason}</span>
                    <span class="chip-kind">{event.planned ? ui.demo.planned : ui.demo.unplanned}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

{config && <script type="application/json" id="demo-config" is:inline set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />}

<script>
  import { INITIAL_STATE, computeMetrics, currentReason, faultTime, machineStatus, messageKey } from '../../lib/demo';
  import type { Demo, DemoState } from '../../lib/demo';
  import { fill } from '../../lib/text';
  import type { Twin } from '../../lib/twin/scene';

  const root = document.querySelector<HTMLElement>('#demo');
  const configEl = document.getElementById('demo-config');

  if (root && configEl?.textContent) {
    const { demo, ui, twin: twinUi } = JSON.parse(configEl.textContent) as {
      demo: Demo;
      ui: Record<string, string>;
      twin: { enlarge: string; restore: string };
    };
    let state: DemoState = { ...INITIAL_STATE };

    const q = <T extends Element>(selector: string) => root.querySelector<T>(selector);
    const el = (tag: string, className: string, text: string) => {
      const node = document.createElement(tag);
      node.className = className;
      node.textContent = text;
      return node;
    };

    // Scene mounts once, when the stage gets close to the viewport
    let twin: Twin | null = null;
    let mounting = false;

    const syncTwin = () => {
      if (!twin) return;
      const machines = Object.fromEntries(
        demo.machines.map((machine) => [machine.id, machineStatus(demo, state, machine.name)]),
      ) as Record<string, 'running' | 'faulted'>;
      twin.update({ machines: machines as Record<'m1' | 'm2' | 'm3', 'running' | 'faulted'>, running: true });
    };

    type Box = { left: number; top: number; right: number; bottom: number };

    // Each label tries a few spots around its machine and takes the first one clear of the HUD
    const positionTags = () => {
      if (!twin) return;
      const sceneEl = q<HTMLElement>('[data-scene]');
      if (!sceneEl) return;
      const bounds = sceneEl.getBoundingClientRect();
      const obstacles = ['.hud-top', '.hud-bottom']
        .map((selector) => q<HTMLElement>(selector)?.getBoundingClientRect())
        .filter((rect): rect is DOMRect => !!rect);
      const hits = (a: Box, b: DOMRect) =>
        a.left < b.right + 6 && a.right > b.left - 6 && a.top < b.bottom + 6 && a.bottom > b.top - 6;

      root.querySelectorAll<HTMLElement>('[data-tag]').forEach((tag) => {
        const p = twin!.project(tag.dataset.tag as 'm1' | 'm2' | 'm3');
        const w = tag.offsetWidth;
        const h = tag.offsetHeight;
        const ax = bounds.left + p.x;
        const ay = bounds.top + p.y;
        const spots = [
          { left: ax - w / 2, top: ay - h - 10 },
          { left: ax + 14, top: ay - h / 2 },
          { left: ax - w - 14, top: ay - h / 2 },
          { left: ax - w / 2, top: ay + 10 },
        ];
        const spot = spots.find((c) => {
          const box = { left: c.left, top: c.top, right: c.left + w, bottom: c.top + h };
          const inside = box.left >= bounds.left && box.right <= bounds.right && box.top >= bounds.top && box.bottom <= bounds.bottom;
          return p.visible && inside && !obstacles.some((o) => hits(box, o));
        });
        if (spot) {
          tag.style.transform = `translate(${spot.left - bounds.left}px, ${spot.top - bounds.top}px)`;
          tag.style.opacity = '1';
        } else {
          tag.style.opacity = '0';
        }
      });
      requestAnimationFrame(positionTags);
    };

    const mount = async () => {
      const scene = q<HTMLElement>('[data-scene]');
      if (!scene || twin || mounting) return;
      mounting = true;
      const { mountTwin } = await import('../../lib/twin/scene');
      twin = scene ? mountTwin(scene) : null;
      mounting = false;
      if (twin) positionTags();
      else root.querySelectorAll<HTMLElement>('[data-tag]').forEach((tag) => (tag.hidden = true));
      syncTwin();
    };

    const scene = q<HTMLElement>('[data-scene]');
    if (scene && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            mount();
            observer.disconnect();
          }
        },
        { rootMargin: '200px' },
      );
      observer.observe(scene);
    } else {
      mount();
    }

    const renderMachines = () => {
      root.querySelectorAll<HTMLElement>('[data-machine]').forEach((pill) => {
        const faulted = machineStatus(demo, state, pill.dataset.machine ?? '') === 'faulted';
        pill.classList.toggle('faulted', faulted);
        pill.classList.toggle('running', !faulted);
        pill.textContent = faulted ? ui.faulted : ui.running;
      });
    };

    const renderControls = () => {
      const fault = q<HTMLButtonElement>('[data-fault]');
      const restart = q<HTMLButtonElement>('[data-restart]');
      const prompt = q<HTMLElement>('[data-prompt]');
      const message = q<HTMLElement>('[data-message]');
      if (fault) fault.hidden = state.open;
      if (restart) restart.hidden = !(state.open && currentReason(state) !== null);
      if (prompt) prompt.hidden = !(state.open && currentReason(state) === null);
      if (message) message.textContent = demo.messages[messageKey(demo, state)];
    };

    // Seed events plus the breakdown while it is active
    const renderEvents = () => {
      const container = q<HTMLElement>('[data-events]');
      if (!container) return;

      const rows = demo.seedEvents.map((event) => ({
        time: event.time,
        machine: event.machine,
        minutes: event.minutes,
        reason: event.reason,
        planned: event.planned,
        unknown: false,
      }));
      state.stops.forEach((id, index) => {
        const reason = demo.reasons.find((item) => item.id === id);
        rows.push({
          time: faultTime(demo, index),
          machine: demo.fault.machine,
          minutes: demo.fault.minutes,
          reason: reason?.label ?? ui.unknown,
          planned: !!reason?.planned,
          unknown: !reason,
        });
      });

      container.replaceChildren(
        ...rows.map((row) => {
          const line = el('li', 'chip', '');
          line.append(
            el('span', 'chip-time', row.time),
            el('span', 'chip-machine', row.machine),
            el('span', '', fill(ui.minutes, { minutes: row.minutes })),
            el('span', row.unknown ? 'chip-reason chip-unknown' : 'chip-reason', row.reason),
            el('span', 'chip-kind', row.planned ? ui.planned : ui.unplanned),
          );
          return line;
        }),
      );
    };

    const renderMetrics = () => {
      const metrics = computeMetrics(demo, state);
      const oee = q<HTMLElement>('[data-oee]');
      if (oee) oee.textContent = `${metrics.oee}%`;

      for (const key of ['availability', 'performance', 'quality'] as const) {
        const value = metrics[key];
        const label = q<HTMLElement>(`[data-metric="${key}"]`);
        const fillBar = q<HTMLElement>(`[data-fill="${key}"]`);
        if (label) label.textContent = `${value}%`;
        if (fillBar) fillBar.style.width = `${value}%`;
      }

      const unplanned = q<HTMLElement>('[data-unplanned-total]');
      const planned = q<HTMLElement>('[data-planned-total]');
      if (unplanned) unplanned.textContent = fill(ui.unplannedStops, { minutes: metrics.unplanned });
      if (planned) planned.textContent = fill(ui.plannedStops, { minutes: metrics.planned });
    };

    // Guide: 1 running, 2 breakdown, 3 explain the stop, 4 see the OEE
    const renderSteps = () => {
      const active = !state.open ? 0 : currentReason(state) === null ? 2 : 3;
      root.querySelectorAll<HTMLElement>('[data-step]').forEach((item) => {
        const index = Number(item.dataset.step);
        item.classList.toggle('done', index < active);
        item.classList.toggle('current', index === active);
      });
    };

    // Scene labels show the machine state, and an alert while a stop has no reason
    const renderTags = () => {
      root.querySelectorAll<HTMLElement>('[data-tag]').forEach((tag) => {
        const machine = demo.machines.find((item) => item.id === tag.dataset.tag);
        if (!machine) return;
        const faulted = machineStatus(demo, state, machine.name) === 'faulted';
        const alert = faulted && currentReason(state) === null;
        tag.classList.toggle('alert', alert);
        const stateEl = tag.querySelector<HTMLElement>('[data-tag-state]');
        if (stateEl) stateEl.textContent = alert ? ui.faultAlert : faulted ? ui.faulted : ui.running;
      });
    };

    const render = () => {
      renderMachines();
      renderSteps();
      renderTags();
      renderControls();
      renderEvents();
      renderMetrics();
      syncTwin();
    };

    // Move focus to the next control so keyboard users keep their place
    q<HTMLButtonElement>('[data-fault]')?.addEventListener('click', () => {
      state = { stops: [...state.stops, null], open: true };
      render();
      q<HTMLButtonElement>('[data-reason]')?.focus();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-reason]').forEach((button) => {
      button.addEventListener('click', () => {
        state = { ...state, stops: state.stops.map((id, index, all) => (index === all.length - 1 ? button.dataset.reason ?? null : id)) };
        render();
      });
    });

    q<HTMLButtonElement>('[data-restart]')?.addEventListener('click', () => {
      state = { ...state, open: false };
      render();
    });

    q<HTMLButtonElement>('[data-overview]')?.addEventListener('click', () => twin?.resetView());

    // Enlarge the whole stage; the toolbar stays outside the scene
    const stage = q<HTMLElement>('[data-stage]');
    const toggle = q<HTMLButtonElement>('[data-toggle]');
    const setExpanded = (on: boolean) => {
      stage?.classList.toggle('expanded', on);
      document.body.classList.toggle('twin-open', on);
      if (toggle) {
        toggle.setAttribute('aria-expanded', String(on));
        toggle.textContent = on ? twinUi.restore : twinUi.enlarge;
      }
    };
    toggle?.addEventListener('click', () => {
      const expanded = !!stage?.classList.contains('expanded');
      setExpanded(!expanded);
      toggle.focus();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && stage?.classList.contains('expanded')) {
        setExpanded(false);
        toggle?.focus();
      }
    });
  }
</script>

<style>
  .demo {
    background: var(--night);
  }

  .container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 640px;
  }

  h2 {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--on-dark);
  }

  .copy p {
    font-size: 18px;
    line-height: 1.65;
    color: var(--on-dark-muted);
  }

  .disclaimer {
    font-size: 14px;
    color: var(--on-dark-faint);
  }

  .stage {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bar {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .toggle,
  .controls .btn-ghost-dark {
    min-height: 40px;
    padding: 10px 18px;
    background: #0b2742;
    border-color: #3a5a84;
  }

  .view {
    position: relative;
    height: 760px;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #071a2d;
  }

  .scene {
    position: absolute;
    inset: 0;
  }

  .scene :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hud-top {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    background: rgba(4, 23, 43, 0.88);
    border: 1px solid #285476;
    border-radius: 14px;
    color: var(--on-dark);
  }

  .oee-label {
    font-size: 14px;
    color: var(--on-dark-muted);
  }

  .oee {
    font-size: 56px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--signal);
  }

  .bars {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .bar-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
  }

  .bar-head {
    display: flex;
    justify-content: space-between;
  }

  .track {
    height: 8px;
    border-radius: 4px;
    background: #163451;
    overflow: hidden;
  }

  .fill {
    height: 8px;
    border-radius: 4px;
    transition: width 0.3s ease;
  }

  .machine-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--line-dark);
    font-size: 14px;
  }

  .machine-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pill {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-weight: 600;
    background: var(--signal);
    color: var(--night);
  }

  .pill.faulted {
    background: var(--fault);
  }

  .totals {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--on-dark-muted);
  }

  .hud-bottom {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 20px;
    background: rgba(4, 23, 43, 0.97);
    border: 1px solid #285476;
    border-radius: 14px;
    color: var(--on-dark);
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-pill);
    font-size: 13px;
    color: var(--on-dark-muted);
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--panel-dark-2);
    font-size: 12px;
    font-weight: 600;
  }

  .step.done {
    color: var(--on-dark);
  }

  .step.done .step-num {
    background: var(--ok-bg);
    color: var(--ok-fg);
  }

  .step.current {
    border-color: var(--signal);
    color: var(--on-dark);
  }

  .step.current .step-num {
    background: var(--signal);
    color: var(--night);
  }

  .tag {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 6px 10px;
    background: rgba(4, 23, 43, 0.92);
    border: 1px solid #285476;
    border-radius: 10px;
    font-size: 13px;
    color: var(--on-dark);
    white-space: nowrap;
    pointer-events: none;
  }

  .tag-name {
    font-weight: 600;
  }

  .tag-state {
    font-size: 12px;
    color: var(--signal);
  }

  .tag.alert {
    border-color: var(--fault);
  }

  .tag.alert .tag-state {
    color: var(--fault);
    font-weight: 600;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .message {
    flex: 1 1 280px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--on-dark-soft);
  }

  .prompt {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .prompt p {
    font-size: 16px;
    font-weight: 600;
  }

  .reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .btn-reason {
    min-height: 44px;
    padding: 12px 18px;
    border: 0;
    background: var(--on-dark);
    color: var(--night);
    font-size: 15px;
    font-weight: 500;
  }

  .events h3 {
    font-size: 16px;
    font-weight: 600;
  }

  :global(.chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  :global(.chip) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    padding: 8px 14px;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-pill);
    font-size: 13px;
    color: var(--on-dark);
  }

  :global(.chip-time),
  :global(.chip-kind) {
    color: var(--on-dark-muted);
  }

  :global(.chip-machine),
  :global(.chip-reason) {
    font-weight: 600;
  }

  :global(.chip-unknown) {
    color: var(--fault);
  }

  /* Enlarged: fills the screen; the toolbar sits above the scene */
  .stage.expanded {
    position: fixed;
    inset: 0;
    z-index: 100;
    gap: 0;
    background: #001023;
  }

  .stage.expanded .bar {
    padding: 12px 16px;
    background: #04172b;
  }

  .stage.expanded .view {
    flex: 1;
    height: auto;
    border-radius: 0;
  }

  :global(body.twin-open) {
    overflow: hidden;
  }

  @media (max-width: 760px) {
    h2 {
      font-size: 32px;
    }

    .view {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 0;
      overflow: visible;
      background: transparent;
    }

    .scene {
      position: relative;
      inset: auto;
      height: 340px;
      border-radius: var(--radius-card);
      overflow: hidden;
    }

    .stage.expanded .view {
      overflow-y: auto;
    }

    .stage.expanded .scene {
      height: 60vh;
    }

    .hud-top,
    .hud-bottom {
      position: static;
      width: auto;
      max-height: none;
    }

    .oee {
      font-size: 44px;
