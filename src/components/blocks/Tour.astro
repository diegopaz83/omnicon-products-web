---
import { url } from '../../lib/paths';
import type { Product } from '../../lib/schema';

interface Props {
  product: Product;
}

const { tour } = Astro.props.product;
// Clock label for a chapter start, e.g. 78 -> 1:18
const clock = (seconds: number) => `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
---
{tour && (
  <section id="how" class="section tour">
    <div class="container">
      <div class="intro">
        <h2>{tour.title}</h2>
        <p>{tour.intro}</p>
      </div>
      <figure class="frame">
        <video class="clip" autoplay muted loop playsinline preload="metadata" poster={url(tour.video.poster)} aria-label={tour.video.alt}>
          <source src={url(tour.video.src)} type="video/mp4" />
        </video>
      </figure>
      <ol class="points">
        {tour.points.map((point) => (
          <li class="point">
            <button type="button" class="chapter" data-at={point.at}>
              <span class="time">{clock(point.at)}</span>
              <span class="name">{point.title}</span>
              <span class="body">{point.body}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<script>
  // Chapters seek the clip; the current chapter follows playback
  const video = document.querySelector<HTMLVideoElement>('.tour .clip');
  const chapters = Array.from(document.querySelectorAll<HTMLButtonElement>('.tour .chapter'));

  if (video && chapters.length) {
    // Reduced motion: start paused on the poster; chapters still play on request
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
    }

    chapters.forEach((chapter) =>
      chapter.addEventListener('click', () => {
        video.currentTime = Number(chapter.dataset.at);
        void video.play();
      }),
    );

    const markCurrent = () => {
      let current = 0;
      chapters.forEach((chapter, index) => {
        if (video.currentTime >= Number(chapter.dataset.at)) current = index;
      });
      chapters.forEach((chapter, index) => {
        if (index === current) chapter.setAttribute('aria-current', 'step');
        else chapter.removeAttribute('aria-current');
      });
    };
    video.addEventListener('timeupdate', markCurrent);
    markCurrent();
  }
</script>

<style>
  .tour {
    background: var(--white);
  }

  .container {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 720px;
  }

  h2 {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .intro p {
    font-size: 18px;
    line-height: 1.65;
    color: var(--body);
  }

  .frame {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
    box-shadow: 0 30px 80px rgba(0, 28, 63, 0.12);
    background: var(--night);
  }

  .clip {
    display: block;
    width: 100%;
    height: auto;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 16px 20px;
    list-style: none;
  }

  .chapter {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 0 0;
    border: 0;
    border-top: 3px solid var(--line);
    background: transparent;
    text-align: left;
    cursor: pointer;
    color: inherit;
  }

  .chapter[aria-current='step'] {
    border-top-color: var(--action);
  }

  .chapter:focus-visible {
    outline: 3px solid var(--action);
    outline-offset: 4px;
  }

  .time {
    font-size: 13px;
    font-weight: 500;
    color: var(--action);
    font-variant-numeric: tabular-nums;
  }

  .name {
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
  }

  .body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    h2 {
      font-size: 32px;
    }
  }
</style>
