---
import { url } from '../../lib/paths';
import type { Product } from '../../lib/schema';

interface Props {
  product: Product;
}

const { problem } = Astro.props.product;
---
{problem && (
  <section class="section problem">
    <div class="container grid">
      <div class="copy">
        <h2>{problem.title}</h2>
        <ul class="statements">
          {problem.statements.map((statement) => <li>{statement}</li>)}
        </ul>
      </div>
      <img class="photo" src={url(problem.image.src)} alt={problem.image.alt} width="1200" height="920" loading="lazy" />
    </div>
  </section>
)}

<style>
  .problem {
    background: var(--paper);
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: center;
  }

  .copy {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  h2 {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .statements {
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .statements li {
    padding: 20px 0;
    border-top: 1px solid var(--line);
    font-size: 20px;
    line-height: 1.5;
    color: var(--body);
  }

  .photo {
    flex: 1 1 420px;
    min-width: 0;
    width: 100%;
    height: 460px;
    object-fit: cover;
    border-radius: 28px;
  }

  @media (max-width: 760px) {
    h2 {
      font-size: 32px;
    }

    .photo {
      height: 280px;
    }
  }
</style>
