---
interface Props {
  title: string;
  body: string;
  button: string;
  href: string;
}

const { title, body, button, href } = Astro.props;
---
<section id="contact" class="section cta on-dark">
  <div class="container">
    <div class="copy">
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <a class="btn btn-signal" href={href}>{button}</a>
  </div>
</section>

<style>
  .cta {
    background: var(--night);
    color: var(--on-dark-muted);
    padding-bottom: 88px;
  }

  .container {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .copy {
    flex: 1 1 360px;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    font-size: 36px;
    font-weight: 300;
    line-height: 1.15;
    color: var(--on-dark);
  }

  p {
    font-size: 17px;
    line-height: 1.6;
  }

  .btn {
    padding: 16px 28px;
    min-height: 52px;
  }

  @media (max-width: 760px) {
    h2 {
      font-size: 28px;
    }
  }
</style>
