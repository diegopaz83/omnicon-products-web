---
import '../styles/global.css';
import { getSite } from '../lib/data';
import { url } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  // Set for internal pages
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const { ui } = getSite();

// Self-hosted Poppins (SPEC §3); base-aware URLs
const weights: [number, string][] = [
  [300, 'Light'],
  [400, 'Regular'],
  [500, 'Medium'],
  [600, 'SemiBold'],
];
const fontFaces = weights
  .map(
    ([weight, name]) =>
      `@font-face{font-family:'Poppins';font-style:normal;font-weight:${weight};font-display:swap;src:url('${url(`brand/fonts/poppins/Poppins-${name}.woff2`)}') format('woff2')}`,
  )
  .join('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <style set:html={fontFaces} />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <slot />
  </body>
</html>
